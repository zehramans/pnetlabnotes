
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// Change 0x27 to 0x3F if your LCD uses that address.
LiquidCrystal_I2C lcd(0x27, 16, 2);

const int TOUCH_PIN = 8;
const int TRIG_PIN = 7;
const int ECHO_PIN = 6;

// Photo sections: 8 custom characters per section.
const byte photoGlyphs[3][8][8] = {
  {
    {0,0,0,0,5,0,2,1},
    {0,4,2,15,23,31,30,27},
    {5,19,13,4,6,23,5,7},
    {0,0,0,0,0,0,0,0},
    {0,21,0,4,0,4,0,18},
    {1,11,21,29,31,30,29,15},
    {8,24,28,20,30,29,30,10},
    {31,31,27,31,29,11,22,10}
  },
  {
    {0,0,0,0,0,0,0,0},
    {21,3,21,27,9,23,10,27},
    {1,21,6,10,4,26,5,21},
    {16,8,4,24,5,8,20,10},
    {0,2,1,2,5,19,13,21},
    {14,19,30,11,21,12,10,8},
    {16,0,26,5,22,10,21,13},
    {22,27,13,22,26,10,21,2}
  },
  {
    {10,13,21,10,23,0,0,0},
    {15,23,15,29,31,31,31,31},
    {31,31,31,31,31,0,0,0},
    {19,8,18,21,10,0,0,16},
    {20,11,26,19,29,28,23,27},
    {18,26,1,5,20,0,0,0},
    {0,0,5,10,1,4,5,4},
    {20,10,16,10,9,18,13,31}
  }
};

// Character positions for each photo section.
const byte photoMap[3][32] = {
  {
    3,4,3,3,3,4,1,5,
    5,3,3,3,3,3,3,0,
    3,3,3,3,0,2,7,5,
    2,6,3,3,3,3,3,3
  },
  {
    0,0,0,0,0,0,2,5,
    1,3,4,5,1,6,0,0,
    7,3,0,4,4,2,1,5,
    0,2,5,6,5,1,3,0
  },
  {
    6,3,1,1,3,3,3,0,
    7,6,1,4,7,1,4,1,
    3,0,2,2,0,5,5,5,
    2,2,2,2,2,2,2,2
  }
};

unsigned long lastPhotoChange = 0;
unsigned long lastActivity = 0;

int photoPage = 0;

bool photoMode = false;
bool wasTouched = false;

float getDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  unsigned long duration = pulseIn(ECHO_PIN, HIGH, 25000);

  if (duration == 0) return 999;

  return duration * 0.0343 / 2;
}

void showEyes() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("   ^       ^");

  lcd.setCursor(0, 1);
  lcd.print("      smile");
}

void showSquishedEyes() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("   -       -");

  lcd.setCursor(0, 1);
  lcd.print("    hehe <3");
}

void showHeartEyes() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("   <3     <3");

  lcd.setCursor(0, 1);
  lcd.print("   I love u!");
}

void showPhoto(int page) {
  lcd.clear();

  // Load this section's eight custom characters.
  for (int i = 0; i < 8; i++) {
    lcd.createChar(i, (byte*)photoGlyphs[page][i]);
  }

  // Draw 16 characters on each row.
  for (int row = 0; row < 2; row++) {
    lcd.setCursor(0, row);

    for (int col = 0; col < 16; col++) {
      lcd.write(photoMap[page][row * 16 + col]);
    }
  }
}

void setup() {
  pinMode(TOUCH_PIN, INPUT);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  lcd.init();
  lcd.backlight();

  lastActivity = millis();

  showEyes();
}

void loop() {
  bool touched = digitalRead(TOUCH_PIN);
  float distance = getDistance();

  // Touch reaction
  if (touched && !wasTouched) {
    lastActivity = millis();
    photoMode = false;

    showSquishedEyes();
    delay(700);
    showHeartEyes();
    delay(1000);
    showEyes();
  }

  wasTouched = touched;

  // Detect someone approaching
  if (distance < 60) {
    lastActivity = millis();
    photoMode = false;

    showEyes();
  }

  // Enter photo mode after 10 seconds without activity.
  if (millis() - lastActivity > 10000) {
    photoMode = true;
  }

  // Cycle through the three photo sections.
  if (photoMode &&
      millis() - lastPhotoChange > 2500) {

    showPhoto(photoPage);

    photoPage++;
    if (photoPage >= 3) {
      photoPage = 0;
    }

    lastPhotoChange = millis();
  }

  delay(50);
}
